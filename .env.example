# Optional Sentinel monitoring tuning
# SERVICE_CHECK_INTERVAL_MS=5000
# SERVICE_FAILURE_THRESHOLD=2
# SERVICE_RECOVERY_THRESHOLD=2

# ---- AI + policy + alerting pipeline ----
# Shared secret Alertmanager uses to call POST /api/alerts/webhook (generate with the setup script or: openssl rand -base64 36)
ALERT_WEBHOOK_TOKEN=GENERATE_WITH_SETUP_SCRIPT
# true = Sentinel restarts a service by itself when the policy says "allow". Default false: a person approves.
PIPELINE_AUTOHEAL=false
PIPELINE_ENABLED=true
# Selects the policy environment block (production or development)
SENTINEL_ENVIRONMENT=production
# Optional LLM for the AI engine. Leave blank to use rules only. LLM_PROVIDER: openai | openai-compatible | anthropic
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

